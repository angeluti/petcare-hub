    {
      "parameters": {
        "jsCode": "// CM-02: texto do lembrete com SIM / NÃO. A resposta é tratada pelo bot\n// (bot_responder_lembrete) quando o tutor responder.\nreturn $input.all().map((it) => {\n  const l = it.json.lembrete;\n  const env = (it.json.resultados.envio || {}).body || {};\n  const nome = String(l.nome_tutor || '').split(' ')[0];\n  const texto = `Oi${nome ? ', ' + nome : ''}! Aqui é ${l.nome_bot || 'a assistente'} 🐾\\n`\n    + `Lembrete: amanhã (${l.data}) às ${l.hora} tem ${l.servicos || 'atendimento'} para ${l.pet}.\\n\\n`\n    + 'Responda *SIM* para confirmar ou *NÃO* se não puder vir.';\n  return { json: { envio: { petshop_id: l.petshop_id, para: l.telefone, phone: String(l.telefone).replace(/\\D/g, ''),\n    texto, tipo: 'lembrete', agendamento_id: l.agendamento_id, instancia: env.zapi_instance_id, token: env.token } } };\n});\n"
      },
      "id": "1d22959a-1662-46c6-94da-58609d347662",
      "name": "Montar lembrete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.z-api.io/instances/{{ $json.envio.instancia }}/token/{{ $json.envio.token }}/send-text",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.envio.phone, message: $json.envio.texto }) }}"
      },
      "id": "c545b955-4793-4ae6-95cc-003ffabc1655",
      "name": "Z-API · lembrete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TROCAR",
          "name": "Z-API · Client-Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Depois do envio: registra em mensagens_log (CM-11) com o id da Z-API.\n// O id é o que faz o fromMe do próprio bot ser reconhecido e ignorado.\nconst envios = $('Montar lembrete').all();\nreturn $input.all().map((r, i) => {\n  const e = envios[i].json.envio;\n  const j = r.json || {};\n  const ok = j.statusCode >= 200 && j.statusCode < 300;\n  const idExterno = ok && j.body ? (j.body.messageId || j.body.id || j.body.zaapId || null) : null;\n  return { json: {\n    envio: { ...e, token: undefined },\n    falhou: !ok,\n    resultados: {},\n    proximo: { chave: 'log', fn: 'bot_registrar_mensagem', args: {\n      p_petshop: e.petshop_id, p_telefone: e.para, p_direcao: 'saida', p_tipo: e.tipo,\n      p_status: ok ? 'enviada' : 'falha', p_agendamento: e.agendamento_id || null,\n      p_id_externo: idExterno, p_erro: ok ? null : JSON.stringify(j.body || j.error || j).slice(0, 500) } },\n  } };\n});\n"
      },
