  "nodes": [
    {
      "parameters": {},
      "id": "94b9d956-d9b4-4465-8830-af09261c469e",
      "name": "Quando um workflow falhar",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $json; const ex = j.execution || {}; const wf = j.workflow || {};\nconst erro = ex.error || (j.trigger && j.trigger.error) || {};\nconst args = {\n  p_workflow: wf.name || '?', p_no: ex.lastNodeExecuted || (erro.node && erro.node.name) || null,\n  p_mensagem: String(erro.message || erro.description || 'erro sem mensagem').slice(0, 2000),\n  p_execucao: ex.id ? String(ex.id) : null, p_url: ex.url || null, p_petshop: null,\n};\nreturn [{ json: { erro: args, resultados: {}, proximo: { chave: 'erro', fn: 'bot_registrar_erro', args } } }];\n"
      },
      "id": "3334de62-8438-47c5-815c-77941a470798",
      "name": "Montar erro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "PetCare · RPC Supabase"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "e328e2e7-d436-4423-817d-9146094ff70f",
      "name": "RPC · registrar erro",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9bd57944-8048-4ebd-8cc7-0cf51fd84b0f",
              "leftValue": "={{ !!($json.resultados.erro.body && $json.resultados.erro.body.enviar_email) || ($json.resultados.erro.status !== 200) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "ffefd587-ffbd-4367-8b27-929b6b6741f0",
      "name": "Primeiro da hora?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json.erro;\nreturn [{ json: { email: {\n  assunto: `🔴 Erro no N8n: ${e.p_workflow}`,\n  texto: `Workflow: ${e.p_workflow}\\nNó: ${e.p_no || '-'}\\nErro: ${e.p_mensagem}\\nExecução: ${e.p_url || e.p_execucao || '-'}\\n\\nOutros erros da próxima hora ficam só na tabela fluxo_erros (sem e-mail).`,\n} } }];\n"
      },
      "id": "44b8f24b-7109-4df8-8229-6cd9e65aa9d0",
      "name": "Montar e-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
