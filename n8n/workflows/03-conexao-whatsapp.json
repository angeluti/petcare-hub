{
  "name": "PetCare · Conexão WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "720220d8-7409-405c-89d4-40d4a538dadf",
      "name": "A cada 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { resultados: {}, proximo: { chave: 'inst', fn: 'bot_instancias_monitoradas', args: {} } } }];\n"
      },
      "id": "ddc23ad6-de96-42cd-8278-cf113e3b6a64",
      "name": "Pedir instâncias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "PetCare · RPC Supabase"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "30387fcd-65fa-4d56-8773-fee51fb6c832",
      "name": "RPC · instâncias",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json.resultados.inst;\nif (!r || r.status !== 200) throw new Error('bot_instancias_monitoradas falhou: ' + JSON.stringify(r));\nreturn (r.body || []).filter((x) => x.canal === 'evolution' && x.instancia).map((x) => ({ json: { inst: x } }));\n"
      },
      "id": "bde432d9-d5d8-49ce-88e7-2ca63efadc1b",
      "name": "Um item por instância",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://evolution-api.railway.internal:8080/instance/connectionState/{{ $json.inst.instancia }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "id": "95924a47-674c-48a9-8644-e3998fa58d75",
      "name": "Evolution · estado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TROCAR",
          "name": "evolution global"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// GET /instance/connectionState/{instancia} → { instance: { instanceName, state } }.\n// open = conectado. close ou connecting há 15 min = caído. 404 = a instância não existe\n// mais na Evolution (apagada ou banco perdido): conta como queda.\n// Sem resposta da Evolution (rede, 5xx) não conta como queda: evita alarme falso,\n// e o erro de rede aparece no 04 se repetir.\nconst insts = $('Um item por instância').all();\nreturn $input.all().flatMap((r, i) => {\n  const x = insts[i].json.inst;\n  const j = r.json || {};\n  let conectado = null, detalhe = null;\n  if (j.statusCode === 404) { conectado = false; detalhe = 'instância não encontrada na Evolution'; }\n  else if (j.statusCode >= 200 && j.statusCode < 300) {\n    const b = j.body || {};\n    const estado = (b.instance && b.instance.state) || b.state || '?';\n    conectado = estado === 'open';\n    detalhe = conectado ? null : 'cron: estado ' + estado;\n  }\n  if (conectado === null) return [];\n  return [{ json: { resultados: {}, proximo: { chave: 'evento', fn: 'bot_conexao_evento',\n    args: { p_instance: x.instancia, p_conectado: conectado, p_detalhe: detalhe } } } }];\n});\n"
      },
      "id": "d5726014-f298-4efc-8e76-1ef76947b5f7",
      "name": "Interpretar estado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "PetCare · RPC Supabase"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "467eadc4-c8cb-4d09-8908-1a2c43ccf60f",
      "name": "RPC · registrar conexão",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0e630065-ba7e-450d-85aa-4739f71a3c40",
              "leftValue": "={{ !!($json.resultados.evento.body && ($json.resultados.evento.body.alertar_queda || $json.resultados.evento.body.alertar_volta)) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "d60f8fe5-2c74-44a4-840f-a180f4b5f78b",
      "name": "Alertar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((it) => {\n  const e = it.json.resultados.evento.body;\n  const queda = e.alertar_queda;\n  return { json: { email: {\n    assunto: queda ? `⚠️ WhatsApp desconectado: ${e.petshop}` : `✅ WhatsApp reconectado: ${e.petshop}`,\n    texto: queda\n      ? `O WhatsApp do pet shop ${e.petshop} está desconectado da Evolution API.\\nBot ligado: ${e.bot_ativo ? 'sim' : 'não'}.\\nDetalhe: ${e.detalhe || '-'}\\n\\nO que fazer: abrir o manager da Evolution (/manager), entrar na instância e conectar de novo (QR ou código de pareamento) com o celular do pet shop. Se o detalhe cita 401, o aparelho foi removido no celular.\\nEnquanto isso, o bot não responde e os lembretes não saem.\\nEste alerta se repete a cada 6 horas enquanto a conexão não voltar.`\n      : `O WhatsApp do pet shop ${e.petshop} voltou a se conectar. Nada a fazer.`,\n  } } };\n});\n"
      },
      "id": "85f06b3d-55dd-4a49-880e-34bdcda1595e",
      "name": "Montar e-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'PetCare Hub · Alertas <noreply@petcarehub.com.br>', to: ['suporte@petcarehub.com.br'], subject: $json.email.assunto, text: $json.email.texto }) }}"
      },
      "id": "503a1ba1-4323-4a7a-8f8e-80a62879fafc",
      "name": "Resend · e-mail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TROCAR",
          "name": "resend n8n-alertas"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "content": "## Conexão do WhatsApp (PL-03)\nA cada 15 min consulta `connectionState` de cada instância com a chave global (`evolution global`).\nO webhook `connection.update` é tratado no **01 · Bot conversa**.\n`bot_conexao_evento` decide se alerta: na queda, de novo a cada 6 h se continuar caído, e na volta.\nE-mail via Resend para suporte@.",
        "height": 240,
        "width": 560
      },
      "id": "63600e37-0cae-4657-8b21-8a22c25a8500",
      "name": "Nota 2ac4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ]
    }
