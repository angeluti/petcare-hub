---
import '@fontsource/young-serif/400.css';
import '@fontsource-variable/figtree/index.css';
import '@fontsource/jetbrains-mono/500.css';
import '../../../../packages/brand/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  titulo?: string;
  descricao?: string;
  /** JSON-LD extra (objeto ou lista), serializado no <head>. */
  dadosEstruturados?: unknown;
  semIndice?: boolean;
}

const { titulo, descricao = SITE.descricao, dadosEstruturados, semIndice = false } = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${SITE.nome}` : `${SITE.nome} · Agendamento de banho e tosa pelo WhatsApp`;
const caminho = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(caminho, SITE.url).toString();
const imagemOg = new URL('/og.png', SITE.url).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    {semIndice && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3f7f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1524" media="(prefers-color-scheme: dark)" />

    {dadosEstruturados && (
      <script type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
    )}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
