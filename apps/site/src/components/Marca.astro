---
/**
 * Marca do PetCare Hub: quatro pontos ligados a um centro (um "hub" que lembra uma pegada).
 * Provisória até a identidade visual definitiva; usa currentColor e o acento da marca.
 */
interface Props {
  tamanho?: number;
  comNome?: boolean;
}
const { tamanho = 30, comNome = true } = Astro.props;
---

<span class="marca">
  <svg width={tamanho} height={tamanho} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <g stroke="var(--pc-azul)" stroke-width="1.6" stroke-linecap="round" opacity="0.55">
      <line x1="16" y1="21" x2="6.5" y2="12.5" />
      <line x1="16" y1="21" x2="12" y2="6.5" />
      <line x1="16" y1="21" x2="20" y2="6.5" />
      <line x1="16" y1="21" x2="25.5" y2="12.5" />
    </g>
    <g fill="var(--pc-azul)">
      <circle cx="6.5" cy="12.5" r="3" />
      <circle cx="12" cy="6.5" r="3" />
      <circle cx="20" cy="6.5" r="3" />
      <circle cx="25.5" cy="12.5" r="3" />
    </g>
    <ellipse cx="16" cy="22" rx="7" ry="6" fill="currentColor" />
  </svg>
  {comNome && <span class="nome">PetCare <em>Hub</em></span>}
</span>

<style>
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--pc-tinta);
  }
  .nome {
    font-family: var(--pc-fonte-display);
    font-size: 1.28rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .nome em {
    font-style: normal;
    color: var(--pc-azul);
  }
</style>
