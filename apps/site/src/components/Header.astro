---
import BotaoDemo from './BotaoDemo.astro';
import { SITE } from '../config';

const links = [
  { href: '/#como-funciona', texto: 'Como funciona' },
  { href: '/#modulos', texto: 'Módulos' },
  { href: '/#planos', texto: 'Planos' },
  { href: '/#duvidas', texto: 'Dúvidas' },
];
---

<header class="topo faixa">
  <div class="recipiente barra">
    <!-- Logo do pacote de marca, sem alteração. Cor em fundo claro, escuro no tema escuro. -->
    <a href="/" class="link-marca">
      <picture>
        <source srcset="/logo/logo-horizontal-escuro.svg" media="(prefers-color-scheme: dark)" />
        <img src="/logo/logo-horizontal-cor.svg" alt="PetCare Hub, página inicial" width="161" height="40" />
      </picture>
    </a>

    <nav aria-label="Principal" class="nav">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
    </nav>

    <div class="acoes">
      <a class="botao botao-contorno entrar" href={SITE.appUrl}>Entrar</a>
      <BotaoDemo origem="topo" classe="botao botao-principal demo">
        <span class="demo-longo">Agendar demonstração</span>
        <span class="demo-curto">Demonstração</span>
      </BotaoDemo>
    </div>
  </div>
</header>

<style>
  :global(body)::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    z-index: 30;
    background: var(--pc-espuma);
  }

  .topo {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: color-mix(in srgb, var(--pc-espuma) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--pc-linha);
  }

  .barra {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 68px;
  }

  /*
    Área de proteção (README do pacote): 1/4 da largura do símbolo em volta.
    O símbolo ocupa ~74% da altura do SVG; a 40 px de altura, a proteção é ~7,5 px.
    O SVG já traz ~8–12% de respiro interno; os gaps da barra (24 px, ou 12 px no celular)
    e a altura de 68 px completam o resto. Não reduzir esses espaços sem refazer a conta.
  */
  .link-marca {
    --logo-h: 40px;
    display: block;
    flex: none;
    line-height: 0;
    border-radius: 6px;
  }

  .link-marca img {
    display: block;
    height: var(--logo-h);
    width: auto;
    max-width: none;
  }

  .nav {
    flex: 1;
  }

  .nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    color: var(--pc-tinta-suave);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--pc-t-sm);
  }

  .nav a:hover {
    color: var(--pc-tinta);
  }

  .acoes {
    display: flex;
    gap: 0.6rem;
    margin-left: auto;
  }

  .acoes :global(.botao) {
    min-height: 42px;
    padding: 0.5rem 1.05rem;
    font-size: var(--pc-t-sm);
  }

  .demo-curto {
    display: none;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .barra {
      gap: 0.75rem;
    }
    .demo-longo {
      display: none;
    }
    .demo-curto {
      display: inline;
    }
    .acoes :global(.demo svg) {
      display: none;
    }
    .acoes :global(.botao) {
      padding: 0.45rem 0.85rem;
    }
  }

  @media (max-width: 520px) {
    /* 32 px: símbolo com ~24 px, o mínimo com detalhes pelo README */
    .link-marca {
      --logo-h: 32px;
    }
  }
</style>
