# Copie para .env.local e preencha com os valores do projeto Supabase
# (Project Settings → API / API Keys). Só a Publishable key: ela é pública
# por desenho e a segurança está na RLS. NUNCA coloque a Secret key aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Só para o script "npm run tipos" (não vai para o navegador)
SUPABASE_PROJECT_REF=seu-project-ref
